#!/bin/sh

die () {
  echo -e "\n❌ $1"
  exit 1
}

# Mandamiento #2: Antes de realizar un push, todos los tests deben pasar exitosamente.
echo -e "\n🧪 Ejecutando tests..."
npm run test:prepush || die "Tests failed. Please fix before pushing."

echo -e "\n✅ Tests completados."

# Mandamiento #3 y #4: Ahora solo se sincroniza tu smart branch con todas las ramas principales antes de hacer push.
# NOTA: Este script ya no sincroniza las ramas principales entre sí en cascada (main → release/laboratory2 → laboratory → integration).
# Si este cambio de workflow es intencional, documenta explícitamente la modificación en la descripción del PR.
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD) || die "No se pudo obtener la rama actual."
MAIN_BRANCHES=("main" "release/laboratory2" "laboratory" "integration")

# Solo ejecuta el flujo si NO estás en una rama principal
if [[ "$CURRENT_BRANCH" != "integration" && "$CURRENT_BRANCH" != "laboratory" && "$CURRENT_BRANCH" != "release/laboratory2" && "$CURRENT_BRANCH" != "main" ]]; then
  STASH_CREATED=0

  if [ -n "$(git status --porcelain)" ]; then
    echo -e "\n📦 Cambios locales detectados. Guardando stash..."
    git stash -u || die "No se pudo crear stash."
    STASH_CREATED=1
  fi

  for BRANCH in "${MAIN_BRANCHES[@]}"; do
    echo -e "\n🔄 Sincronizando con origin/$BRANCH..."
    git pull --no-rebase origin "$BRANCH" || {
      [ $STASH_CREATED -eq 1 ] && git stash pop
      die "Conflictos o error al hacer pull de '$BRANCH'. Resuélvelos antes de hacer push."
    }
  done

  if [ $STASH_CREATED -eq 1 ]; then
    echo -e "\n📦 Restaurando stash..."
    git stash pop || die "No se pudo aplicar el stash (puede haber conflictos). Resuélvelos manualmente."
  fi
else
  echo -e "\nℹ️ Estás en una rama principal. Solo se recomienda sincronizar desde una smart branch."
  echo -e "\nℹ️ You are on a main branch. Synchronization is only recommended from a smart branch."
fi

echo -e "\n✅ Sincronización completada: tu smart branch está ahora actualizada con todas las ramas principales. Puedes hacer push y abrir el PR."
