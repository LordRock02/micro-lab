die () {
  echo -e "\n❌ $1"
  exit 1
}

echo -e "\n🧹 Ejecutando lint sobre archivos staged..."

# Lista de archivos staged (null-delimited para soportar espacios)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | tr '\n' ' ')
if [ -z "$STAGED_FILES" ]; then
  echo -e "\nℹ️  No new staged files to process (Commit message update)."
  echo -e "\n✅ Lint skipped. You can commit."
  exit 0
fi

# Lint solo sobre lo staged (evita tocar archivos fuera del commit)
# Ajusta extensiones si necesitas (ts, html, scss)
# Nota: ng lint no acepta lista de archivos, por eso usamos eslint directo.
npx eslint $STAGED_FILES --fix
RESULT=$?

if [ $RESULT -ne 0 ]; then
  die "Lint found errors that could not be fixed automatically. Please fix before committing."
fi

# Re-stage SOLO los archivos que ya estaban staged (maneja espacios)
# (git add -- <files...>)
git add -- $STAGED_FILES || die "No se pudieron re-añadir archivos al stage."

# Contar archivos procesados
FIXED_FILES_COUNT=$(printf "%s" "$STAGED_FILES" | wc -w | tr -d ' ')
echo -e "\nℹ️  Files processed/fixed by lint: $FIXED_FILES_COUNT"

echo -e "\n✅ Lint passed or fixed automatically. You can commit."
exit 0
