# Mandamiento #1: Antes de realizar un commit, no deben existir errores de linter en el código.
STAGED_FILES=$(git diff --cached --name-only)

npm run lint:fix
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo "\n❌ Lint found errors that could not be fixed automatically. Please fix before committing."
  exit 1
fi

# --- CAMBIO PRINCIPAL AQUÍ ---
# Solo intentamos re-añadir archivos y contar si la lista NO está vacía.
# Esto evita que el script falle en un 'git commit --amend' sin cambios nuevos.
if [ -n "$STAGED_FILES" ]; then
  
  # Re-add only the files that were staged (usando xargs para mayor estabilidad)
  echo "$STAGED_FILES" | xargs git add

  # Count the number of fixed files
  FIXED_FILES_COUNT=$(echo "$STAGED_FILES" | wc -l)
  
  if [ "$FIXED_FILES_COUNT" -gt 0 ]; then
    echo "\nℹ️  Files processed/fixed by lint: $FIXED_FILES_COUNT"
  fi
else
  echo "\nℹ️  No new staged files to process (Commit message update)."
fi
# --- FIN DEL CAMBIO ---

echo "\n✅ Lint passed or fixed automatically. You can commit."
exit 0